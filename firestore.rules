rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if user is authenticated
    function isSignedIn() {
      return request.auth != null;
    }

    // Helper function to check if user is a supervisor
    function isSupervisor() {
      return isSignedIn() &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'supervisor';
    }

    // Helper function to check if user owns this resource
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // User profiles - users can read their own, supervisors can read all
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isSupervisor() || isOwner(userId);
    }

    function isEmployee(employeeId) {
      return isSignedIn() &&
             string(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.employeeId) == employeeId;
    }

    // Request docs are keyed by employee ID. Delete is open to signed-in users because
    // cancelling a guard's last pending request removes the whole document.
    match /vacationRequests/{employeeId} {
      allow read, write: if isSignedIn();
    }

    match /workRequests/{employeeId} {
      allow read, write: if isSignedIn();
    }

    // Employee profiles - anyone signed in can read, guards edit their own, supervisors edit all
    match /employees/{employeeId} {
      allow read: if isSignedIn();
      allow write: if isSupervisor() || isEmployee(employeeId);
    }

    // Manual overrides - only supervisors can modify
    match /settings/manualOverrides {
      allow read: if isSignedIn();
      allow write: if isSupervisor();
    }

    // General settings - supervisors only
    match /settings/{document} {
      allow read: if isSignedIn();
      allow write: if isSupervisor();
    }

    // Schedules - all authenticated users can read, supervisors can write
    match /schedules/{scheduleId} {
      allow read: if isSignedIn();
      allow write: if isSupervisor();
    }
  }
}
